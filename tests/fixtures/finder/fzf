#!/bin/sh
case " $* " in
*' --with-nth=2.. '*) ;;
*)
	echo .
	exit 0
	;;
esac
listed=$(cat)
echo "acme fzf args: $*" >&2
printf '%s\n' "$listed" | tr '\t' '|' >&2
echo 'acme fzf ready' >&2
newline='
'
answer=
while [ -z "$answer" ]; do
	read=$(dd bs=4096 count=1 </dev/tty 2>/dev/null | tr -d '\000'; echo .)
	read=${read%.}
	[ "${read%"$newline"}" != "$read" ] || exit 130
	answer=${read%"$newline"}
done
esc=$(printf '\033')
case $answer in
"$esc"*) exit 130 ;;
broken) exit 2 ;;
cut:*)
	printf '%s\n' "$listed" | grep -F -m1 -e "${answer#cut:}" | cut -f3-
	exit 0
	;;
esac
printf '%s\n' "$listed" | grep -F -m1 -e "$answer" || exit 1
